# ToolHub 环境变量
# 本地:复制为 .env.local;生产:Cloudflare Pages → Settings → Environment variables
# 添加同名变量后重新部署(静态导出时 NEXT_PUBLIC_* 在构建期内联进产物,改完必须重新 build)
NEXT_PUBLIC_SITE_URL=https://toolhub.axtrivc.com
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX  # 可选,合法 ca-pub-数字客户端
# 位置名不会作为 AdSense slot 使用;下列变量必须填后台真实数字广告单元 ID,可跨页面复用
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL_TOP=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL_IN_CONTENT=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL_MID=XXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BOTTOM=XXXXXXXXXX
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=xxxxxxxx  # 可选,Cloudflare Web Analytics 访客统计
#   获取:Cloudflare Dashboard → Analytics & Logs → Web Analytics → Add a site
#   (填 toolhub.axtrivc.com)→ 复制 JS beacon token。无 cookie,设置即全站生效
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX  # 可选,GA4;仅在用户对 Cookie 横幅"接受全部"后加载
