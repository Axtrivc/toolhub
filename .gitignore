# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地工作文件(非工具站代码)
/.zcode/
# 注意:不能忽略整个 /.workbuddy/ 目录,否则 git 不会进入该目录,
# 下面的 ! 白名单(重新包含 memory)将无法生效(git 标准限制:
# 父目录被忽略后无法 re-include 子文件)。改为忽略目录内容 /*。
/.workbuddy/*
# 例外:跨会话记忆必须同步到远程,否则换电脑/新会话会丢失用户偏好与项目上下文
!/.workbuddy/memory/
!/.workbuddy/memory/**
project-overview.html
*.local

# 测试/备份产物(Playwright 截图、CSV 导出、本地备份)
/.playwright-mcp/
/.backups/
# 临时提取文件(脚本调试用)
/.tmp-*
# Windows 误重定向产生的空文件(`> nul` 会创建名为 nul 的文件)
nul

# 根目录的诊断/预览截图(只匹配项目根的 png,不影响 public/ 子目录里的资源)
/*.png
